# Conecta ERP - Variables de Entorno
# NO SUBIR A GIT

# Entorno (development, production)
APP_ENV=development
APP_DEBUG=true
APP_NAME="Conecta ERP"
APP_URL=http://localhost

# Base de datos
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=conectae_conectaerpbd
DB_USERNAME=conectae_conectaerpuser
DB_PASSWORD=pt125824caraud
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sesión
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# Seguridad
HASH_ALGO=bcrypt
HASH_COST=12
CSRF_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900

# Trial
TRIAL_DAYS=14

# Email
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contacto@conectaerp.com
MAIL_FROM_NAME="Conecta ERP"

# Logs
LOG_CHANNEL=file
LOG_LEVEL=debug

# Uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif

# API
API_ENABLED=true
API_RATE_LIMIT=60

# Cache
CACHE_DRIVER=file
CACHE_TTL=3600

# Zona horaria por defecto
DEFAULT_TIMEZONE=America/Santiago

# Locale por defecto
DEFAULT_LOCALE=es
DEFAULT_CURRENCY=CLP
DEFAULT_COUNTRY=CL
